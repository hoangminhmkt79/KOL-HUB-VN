# --- Bắt buộc ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Mật khẩu admin: đặt ADMIN_PASSWORD, HOẶC ADMIN_HASH = sha256(mật khẩu) (npm run hash -- "matkhau")
ADMIN_PASSWORD=
ADMIN_HASH=
# Chuỗi ngẫu nhiên ký cookie đăng nhập (khuyến nghị)
SESSION_SECRET=

# --- Cron automation hằng ngày (Vercel tự gửi Bearer CRON_SECRET) ---
CRON_SECRET=

# --- TikTok Shop Open API (tuỳ chọn, cần app Partner Center đã duyệt) ---
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_ACCESS_TOKEN=
TTS_SHOP_CIPHER=

# --- Cảnh báo cho team (tuỳ chọn) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
